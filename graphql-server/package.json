{
  "name": "@lumina/graphql-server",
  "version": "0.1.0",
  "description": "Apollo GraphQL server exposing indexed Stellar network data",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc && cp src/schema.graphql dist/schema.graphql",
    "start": "node dist/index.js",
    "test": "node --require ts-node/register --test src/db.test.ts src/horizon.test.ts src/pubsub.test.ts src/subscriptions.test.ts src/customEvents.test.ts src/search.test.ts src/keys.test.ts",
    "manage-keys": "node --require ts-node/register src/manageKeys.ts",
    "codegen": "graphql-codegen --config codegen.yml",
    "test:integration": "node --require ts-node/register --test src/pubsub.integration.test.ts src/search.integration.test.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.0.0",
    "@graphql-tools/schema": "^10.1.1",
    "cors": "^2.8.6",
    "dataloader": "^2.0.0",
    "express": "^4.21.2",
    "graphql": "^16.0.0",
    "graphql-tag": "^2.0.0",
    "graphql-ws": "^5.16.2",
    "pg": "^8.0.0",
    "pino": "^8.21.0",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
