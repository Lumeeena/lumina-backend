          }
        }
      ]
    },
    {
      "id": 60,
      "type": "timeseries",
      "title": "GraphQL error rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(lumina_graphql_operations_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(lumina_graphql_operations_total[5m])), 0.001)",
          "legendFormat": "error ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 61,
