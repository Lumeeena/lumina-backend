{
  "name": "@lumina/indexer",
  "version": "0.1.0",
  "description": "Stellar Horizon event indexer \u2014 polls ledgers and writes to PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --require ts-node/register --test src/horizon.test.ts src/db.test.ts src/soroban.test.ts src/notify.test.ts src/customSchema.test.ts src/customDecode.test.ts src/health.test.ts src/metrics.test.ts",
    "test:integration": "node --require ts-node/register --test src/customSchema.integration.test.ts",
    "register-schema": "node --require ts-node/register src/registerSchema.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
    "@opentelemetry/instrumentation-pg": "^0.45.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@sentry/node": "^8.0.0",
    "@stellar/stellar-sdk": "^16.0.0",
    "node-fetch": "^3.0.0",
    "pg": "^8.0.0",
    "pino": "^8.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
